#!/usr/bin/env bash
# 커밋 메시지가 AngularJS 컨벤션을 따르는지 검사한다.
# 설치: git config core.hooksPath .githooks
set -uo pipefail

msg_file="$1"
subject=$(head -n 1 "$msg_file")

# 머지/리버트 커밋은 git이 형식을 정하므로 검사하지 않는다.
case "$subject" in
  "Merge "*|"Revert "*|"fixup!"*|"squash!"*) exit 0 ;;
esac

types="feat|fix|docs|style|refactor|test|chore|perf|ci"
fail() {
  printf '\n[커밋 거부] %s\n\n' "$1" >&2
  printf '  받은 제목: %s\n\n' "$subject" >&2
  cat >&2 <<EOF
  형식: <type>(<scope>): <subject>

  type    $types
  scope   선택. 예: (auth), (entries), (rooms), (photos)
  subject 영어, 현재형 명령문, 첫 글자 소문자, 마침표 없음

  예시:
    feat(auth): verify apple identity tokens
    fix(entries): hide a leaver's records from the partner
    chore: add commit message hook

EOF
  exit 1
}

[ -n "$subject" ] || fail "커밋 메시지가 비어 있다."

printf '%s' "$subject" | grep -qE "^($types)(\([a-z0-9/-]+\))?: .+" \
  || fail "형식이 맞지 않는다."

body=${subject#*: }

[ ${#subject} -le 72 ] || fail "제목이 72자를 넘는다 (${#subject}자)."

printf '%s' "$body" | grep -qE '\.$' \
  && fail "제목 끝에 마침표를 쓰지 않는다."

printf '%s' "$body" | grep -qE '^[A-Z]' \
  && fail "제목 첫 글자는 소문자로 쓴다."

printf '%s' "$body" | grep -qE '[가-힣]' \
  && fail "커밋 메시지는 영어로 작성한다."

# 과거형/3인칭은 흔한 실수라 대표적인 것만 잡는다.
printf '%s' "$body" | grep -qE '^(added|fixed|changed|updated|removed|adds|fixes|changes|updates|removes) ' \
  && fail "현재형 명령문을 쓴다. 'added' 가 아니라 'add'."

grep -qiE '^(co-authored-by|generated with|signed-off-by.*claude)' "$msg_file" \
  && fail "공동 작성자/생성 도구 표기를 넣지 않는다."

exit 0
