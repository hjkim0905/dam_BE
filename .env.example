# 로컬에서는 DB 접속 정보만 있으면 뜬다. 나머지는 application.yml 의 기본값을 쓴다.
DB_URL=jdbc:mysql://localhost:3306/dam?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
DB_USERNAME=root
DB_PASSWORD=

# 운영에서는 반드시 덮는다.
# SESSION_SECRET=
# SPRING_PROFILES_ACTIVE=prod

# 애플 로그인. p8 는 한 번만 받을 수 있으니 잃어버리지 않게 둔다.
# APPLE_BUNDLE_ID=app.dam
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# 사진. 이 넷이 없으면 사진 관련 호출만 준비되지 않았다고 답하고 나머지는 그대로 돈다.
# STORAGE_BUCKET=dam
# STORAGE_REGION=ap-chuncheon-1
# STORAGE_ENDPOINT=https://<namespace>.compat.objectstorage.ap-chuncheon-1.oraclecloud.com
# STORAGE_ACCESS_KEY=
# STORAGE_SECRET_KEY=
